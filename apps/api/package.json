{
  "name": "@logforge/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @logforge/shared",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@logforge/shared": "1.0.0",
    "@prisma/client": "^6.12.0",
    "bullmq": "^6.4.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "ioredis": "^6.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "prisma": "6.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "vitest": "^5.0.5"
  }
}
